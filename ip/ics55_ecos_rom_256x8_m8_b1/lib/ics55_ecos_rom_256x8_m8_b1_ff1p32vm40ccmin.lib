    output_threshold_pct_fall     : 50.00 ;
    input_threshold_pct_rise      : 50.00 ;
    output_threshold_pct_rise     : 50.00 ;

    library_features(report_delay_calculation);

    nom_process       : 1.0 ;
    nom_temperature   : -40 ;
    nom_voltage       : 1.32 ;
    operating_conditions(ff1p32vm40ccmin) {
      process : 1.0000 ;
      temperature : -40 ;
      voltage : 1.32 ;
      tree_type : "balanced_tree" ; 
    }
    default_operating_conditions : ff1p32vm40ccmin ;

          

    voltage_map(VDD, 1.32);
    voltage_map(VSS, 0.0);    



