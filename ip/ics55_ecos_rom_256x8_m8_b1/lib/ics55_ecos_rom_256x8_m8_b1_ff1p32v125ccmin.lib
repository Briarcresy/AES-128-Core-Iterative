library(ics55_ecos_rom_256x8_m8_b1_ff1p32v125ccmin) {


    delay_model             : table_lookup ;
    time_unit               : "1ns" ;
    voltage_unit            : "1V" ;
    current_unit            : "1mA" ;
    leakage_power_unit      : "1pW" ;
    pulling_resistance_unit : "1kohm" ;
    capacitive_load_unit(1.0,pf) ;
                 
    
    slew_derate_from_library      : 1.00 ;
    slew_lower_threshold_pct_rise : 30.0 ;
    slew_upper_threshold_pct_rise : 70.0 ;
    slew_lower_threshold_pct_fall : 30.0 ;
    slew_upper_threshold_pct_fall : 70.0 ;
      

    default_inout_pin_cap         : 0.005 ;
    default_input_pin_cap         : 0.005 ;
    default_output_pin_cap        : 0.0 ;
    default_max_fanout            : 999.0 ;
    default_max_transition        : 0.4 ;
    default_fanout_load           : 1.0 ;
    default_cell_leakage_power    : 0.0 ;
    default_leakage_power_density : 0.0 ;

    input_threshold_pct_fall      : 50.00 ;
    output_threshold_pct_fall     : 50.00 ;
    input_threshold_pct_rise      : 50.00 ;
    output_threshold_pct_rise     : 50.00 ;

    library_features(report_delay_calculation);

    nom_process       : 1.0 ;
    nom_temperature   : 125 ;
    nom_voltage       : 1.32 ;
    operating_conditions(ff1p32v125ccmin) {
      process : 1.0000 ;
      temperature : 125 ;
      voltage : 1.32 ;
      tree_type : "balanced_tree" ; 
    }
    default_operating_conditions : ff1p32v125ccmin ;

          

    voltage_map(VDD, 1.32);
    voltage_map(VSS, 0.0);    



