        <mxCell id="v68" value="AES 模多项式：&#10;m(t) = t⁸ + t⁴ + t³ + t + 1&#10;&#10;0x1b 对应 t⁴ + t³ + t + 1。" style="shape=text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=17;fontStyle=0;fontColor=#566576;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
